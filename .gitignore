# upMVC .gitignore

# Debug and testing files
zbug/
/zbug/
.phpunit.cache/

# Internal planning and features (top secret)
vault/
/vault/**
private-vault/

# Agent CLI generated output (ephemeral)
docs/agent/generated/

# Logs
logs/
*.log

# Vendor dependencies
vendor/
node_modules/

# Environment files
.env
.env.local
.env.production

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Cache files (runtime dirs only — not the src/Etc/Cache source namespace)
cache/
!src/Etc/Cache/
!src/Etc/Cache/**
*.cache

# Database dumps (ad-hoc exports, backups)
*.sql
*.db
*.sqlite

# ...but versioned schema artifacts must ship with the repo
!/database/migrations/*.sql
!/database/schema.sql
!/database/seed.sql

# Demo module tables live in one place: /database/demo-modules.sql (above).
# The per-module .sql files under src/Modules/ stay ignored deliberately —
# shipping both would be two definitions of the same table, free to drift.
!/database/demo-modules.sql

# Runtime state written by the app / CLI tools
/storage/rate-limits/

# Uploaded files (if not needed in repo)
uploads/
files/

# Compiled files
*.com
*.class
*.dll
*.exe
*.o
*.so

# Backup files
*.bak
*.backup
*.old

# Package files
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# Configuration files with sensitive data
config/local.php
config/production.php

# Error logs
error.log
error_log

# PHP specific
composer.phar
/vendor/
# Local safety copies of retired SQL files
/database/junk/

# Demo modules are optional — download from GitHub Releases and paste into src/Modules/.
# Only Welcome ships in the thin create-project (owns '/' via src/Etc/custom-routes.php).
# Local copies stay on disk for development; they are not tracked.
/src/Modules/*
!/src/Modules/Welcome/
!/src/Modules/Welcome/**

# Built demo archive (attach to Releases — do not commit; *.zip already ignored)
/dist/
